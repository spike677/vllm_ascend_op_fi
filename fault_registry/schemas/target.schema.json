{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "layer": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "operator_call": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "rank": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "device": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "request_scope": {
      "enum": [
        "all",
        "selected"
      ]
    },
    "request_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "layer",
    "operator_call",
    "rank",
    "device",
    "request_scope",
    "request_ids"
  ],
  "additionalProperties": false
}
