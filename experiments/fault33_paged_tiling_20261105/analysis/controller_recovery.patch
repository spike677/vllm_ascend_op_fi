+                    recovery['status'] = 'AMBIGUOUS_OR_INVALID_IDENTITY'
+                    raise RuntimeError('Ambiguous token-owned container recovery')
+                if ids:
+                    remaining = deadline - time.monotonic()
+                    if remaining <= 0:
+                        event['status'] = 'INSPECT_DEADLINE_EXHAUSTED'
+                        break
